@model WebQLBH.Models.NhanVien

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>NhanVien</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.HoNV)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.HoNV)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TenNV)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TenNV)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DienThoai)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DienThoai)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TenDN)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TenDN)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AnhNV)
        </dt>
        <dd class = "col-sm-10">
            @if (!string.IsNullOrWhiteSpace(Model.AnhNV))
            {
                <img src="~/images/nhanvien/@Model.AnhNV" alt="Ảnh nhân viên" style="max-width:100px; height:auto;" />
            }
            else
            {
                <span>Không có ảnh</span>
            }
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PhongBan.TenPB)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PhongBan.TenPB)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-manv="@Model?.MaNV">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
