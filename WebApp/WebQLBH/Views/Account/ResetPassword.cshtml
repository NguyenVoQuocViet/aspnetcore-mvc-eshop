@{
	ViewData["Title"] = "Quên Mật Khẩu";
}

<div class="container mt-5">
	<div class="row justify-content-center">
		<div class="col-md-6">
			<div class="card">
				<div class="card-header bg-info text-white">
					<h5 class="mb-0">Reset Mật Khẩu</h5>
				</div>
				<div class="card-body">
					@if (TempData["SuccessMessage"] != null)
					{
						<div class="alert alert-success alert-dismissible fade show" role="alert">
							@TempData["SuccessMessage"]
							<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
						</div>
					}

					@if (TempData["ErrorMessage"] != null)
					{
						<div class="alert alert-danger alert-dismissible fade show" role="alert">
							@TempData["ErrorMessage"]
							<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
						</div>
					}

					<p class="text-muted mb-4">
						Nhập tên đăng nhập của bạn để reset mật khẩu.
						<br />
						Mật khẩu mới sẽ được đặt về mặc định.
					</p>

					<form method="post">
						<div asp-validation-summary="ModelOnly" class="text-danger"></div>

						<div class="mb-3">
							<label for="TenDN" class="form-label">Tên đăng nhập</label>
							<input type="text" class="form-control" id="TenDN" name="TenDN" required placeholder="Nhập tên đăng nhập của bạn" />
						</div>

						<div class="d-grid gap-2">
							<button type="submit" class="btn btn-info text-white">Reset Mật Khẩu</button>
						</div>
					</form>

					<hr />

					<div class="text-center">
						<p class="mb-2">Bạn đã nhớ ra mật khẩu?</p>
						<a href="@Url.Action("Login", "Account")" class="btn btn-outline-primary btn-sm">Quay Lại Đăng Nhập</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	@{await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
