@model IEnumerable<WebQLBH.Models.Tinh>

@{
    ViewData["Title"] = "Index";
}

<h1>Tỉnh</h1>

<p>
    <a asp-action="Create">Thêm mới</a>
</p>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Lỗi:</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MaTinh)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TenTinh)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
                <td>
                    @Html.DisplayFor(model => item.MaTinh)
                </td>
            <td>
                @Html.DisplayFor(model => item.TenTinh)
            </td>
            <td>
                <a asp-action="Edit" asp-route-matinh="@item.MaTinh">Sửa</a> |
                <a asp-action="Details" asp-route-matinh="@item.MaTinh">Chi tiết</a> |
                <a asp-action="Delete" asp-route-matinh="@item.MaTinh">Xóa</a>
            </td>
        </tr>
}
    </tbody>
</table>
