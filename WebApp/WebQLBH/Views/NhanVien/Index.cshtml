@model IEnumerable<WebQLBH.Models.NhanVien>

@{
    ViewData["Title"] = "Index";
}

<h1>Nhân viên</h1>

<p>
    <a asp-action="Create">Thêm mới</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.HoNV)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TenNV)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DienThoai)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TenDN)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AnhNV)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhongBan.TenPB)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.HoNV)
            </td>
            <td>
                @Html.DisplayFor(model => item.TenNV)
            </td>
            <td>
                @Html.DisplayFor(model => item.DienThoai)
            </td>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                @Html.DisplayFor(model => item.TenDN)
            </td>
            <td>
                @if (!string.IsNullOrWhiteSpace(item.AnhNV))
                {
                    <img src="~/images/nhanvien/@item.AnhNV" alt="Ảnh nhân viên" style="max-width:100px; height:auto;" />
                }
                else
                {
                    <span>Không có ảnh</span>
                }
            </td>
            <td>
                @Html.DisplayFor(model => item.PhongBan.TenPB)
            </td>
            <td>
                <a asp-action="Edit" asp-route-manv="@item.MaNV">Sửa</a> |
                <a asp-action="Details" asp-route-manv="@item.MaNV">Chi tiết</a> |
                <a asp-action="Delete" asp-route-manv="@item.MaNV">Xóa</a>
            </td>
        </tr>
}
    </tbody>
</table>
